<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Without this, VZVirtualMachine.init throws and no VM can be created
	     at all. `ci/sign-macos.sh` applies it and then VERIFIES it, because
	     a signature that silently lacks the entitlement produces a binary
	     that builds, runs, and cannot start a guest. -->
	<key>com.apple.security.virtualization</key>
	<true/>
</dict>
</plist>
