# Rust
/target
**/*.rs.bk

# Rachna's per-project convenience folder. Holds nothing load-bearing: the
# real state (store, shims, disks, snapshots) lives in
# ~/.local/share/rachna/<project-id>/, outside the workspace mount, because the
# guest can write anything inside the project folder.
# See design-docs/08-POLICY-AND-STORE.md §4.
/.rachna

# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# cargo-mutants working output
/mutants.out
/mutants.out.old
